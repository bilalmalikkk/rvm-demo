# CMS API Configuration
# Use the same CMS backend as Nordic-Medtek
# Replace with your actual Railway CMS URL

# Production CMS URL (same as Nordic-Medtek)
VITE_API_URL=https://nordic-medtek-cms-production.up.railway.app

# For local development, use:
# VITE_API_URL=http://localhost:3001

# Note: The API base URL should NOT include /api at the end
# The News component and Admin page will append /api/news automatically

# EmailJS Configuration
# Get these values from your EmailJS account: https://www.emailjs.com/
# 1. Create an account at https://www.emailjs.com/
# 2. Create an email service (Gmail, Outlook, etc.)
# 3. Create an email template
# 4. Get your Public Key from Account > API Keys
VITE_EMAILJS_SERVICE_ID=service_byox94m
VITE_EMAILJS_TEMPLATE_ID=template_xmd40za
VITE_EMAILJS_PUBLIC_KEY=7pHb8qiUfZXp_6KWX
